{
  "//": "OWNER: ROLE 1 — root workspace manifest. Role-specific packages carry their own owner comments.",
  "name": "trout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, privacy-first decision tool for trout anglers (match the hatch, stream conditions, stocking, shop reports).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:infra": "node --test infra/static-server.test.mjs",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "pnpm --filter @trout/content validate && node apps/web/scripts/audit-water-identities.mjs",
    "validate:water-identities": "node apps/web/scripts/audit-water-identities.mjs",
    "gauges:build": "node scripts/tn-gauges-build.mjs",
    "gauges:check": "node scripts/tn-gauges-build.mjs --check",
    "twra:build": "node scripts/twra-layers-build.mjs",
    "twra:check": "node scripts/twra-layers-build.mjs --check",
    "e2e": "pnpm --filter @trout/e2e e2e",
    "e2e:web": "pnpm --filter @trout/e2e exec playwright test --project=web"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}

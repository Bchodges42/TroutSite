# Copy to .env for local runs and fill in real values on the server.
# NEVER commit a real .env — only this example file belongs in git.

# Secret used to derive shop portal tokens (Role 3/4 server side). Use a long random string.
PORTAL_SECRET=replace-with-a-long-random-string

# Optional shared secret for private /healthz watchdog probes. Leave unset for local development.
WATCHDOG_TOKEN=replace-with-a-different-long-random-string

# User-Agent sent to the USGS Water Data API. USGS etiquette requires a contact email.
USGS_USER_AGENT=trout-local/0.1.0 (contact: you@example.com)
# Modern USGS provider is the default. Use legacy only for rollback during migration.
USGS_PROVIDER=waterdata
# Optional server-only key from https://api.waterdata.usgs.gov/signup (never ship to browser).
USGS_WATERDATA_API_KEY=

# Public base URL of the site (used when generating absolute links).
SITE_URL=http://localhost:8787

# Optional production-only Cloudflare Web Analytics token. Keep the real value
# in the ignored .env on the deployment host; do not commit it.
VITE_CF_ANALYTICS_TOKEN=replace-with-cloudflare-web-analytics-token

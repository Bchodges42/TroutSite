# dependencies
node_modules/

# build outputs
dist/
.astro/
*.tsbuildinfo
.eslintcache
# generated snapshot JSONs (ROLE 3/6) — regenerate with `pnpm --filter api snapshots`
# written at the served /v1/* URLs + /content/* content pack (ADR 0005 in docs/adr/)
apps/web/public/data/
apps/web/public/v1/
apps/web/public/content/

# local runtime data (SQLite lives at apps/api/data/trout.db — never commit)
apps/api/data/
backups/
*.db
*.db-journal
*.db-wal
*.db-shm

# coverage
coverage/

# secrets — .env.example is the only env file committed
.env
.env.*
!.env.example

# logs & OS noise
pnpm-debug.log*
*.log
.DS_Store
Thumbs.db

# test artifacts
test-results/
playwright-report/

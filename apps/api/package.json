{
  "//": "OWNER: ROLE 3 — Fastify app, scrapers, cron, snapshot builder. ROLE 1 created only the skeleton (health route, migrations, seed) as the Phase-0 foundation.",
  "name": "@trout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:cron": "tsx src/cron.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:cron": "node dist/cron.js",
    "seed": "pnpm --filter @trout/contracts build && tsx src/scripts/seed.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "snapshots": "pnpm --filter @trout/contracts build && tsx src/scripts/ingest.ts --job=snapshots",
    "token": "tsx src/scripts/token.ts",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@trout/contracts": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^4.28.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/static": "^7.0.4",
    "node-cron": "^3.0.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}

# Copy to .env when running the API from apps/api. Never commit a real .env.

# Secret used to derive shop portal tokens. Use a long random string.
PORTAL_SECRET=replace-with-a-long-random-string

# Optional shared secret for private /healthz watchdog probes.
# Leave unset for local development; production watchdog callers must send it.
WATCHDOG_TOKEN=replace-with-a-different-long-random-string

# User-Agent sent to the USGS Waterservices API.
USGS_USER_AGENT=trout-local/0.1.0 (contact: you@example.com)

# Public base URL used when generating absolute links.
SITE_URL=http://localhost:8787

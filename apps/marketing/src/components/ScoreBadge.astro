---
/**
 * Fishability score badge — renders the score computed by the frozen
 * `scoreConditions()` pure function (loaded at build time). Static by design.
 */
import { scoreLabel } from '../lib/format';

export interface Props {
  value: number;
}

const { value } = Astro.props;
const color = value >= 75 ? '#15803d' : value >= 50 ? '#d97706' : value > 0 ? '#b91c1c' : '#94a3b8';
---

<span class="score">
  <span class="dot" style={`background:${color}`} aria-hidden="true"></span>
  <span>{value}<span style="color:var(--muted)">/100</span> · {scoreLabel(value)}</span>
</span>

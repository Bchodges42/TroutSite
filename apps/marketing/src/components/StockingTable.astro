---
/**
 * Stocking table — ROLE 5. Renders agency-published stocking schedule entries
 * with per-row attribution to the official source (attribution culture, §1.5).
 * F08: every row keeps its PUBLISHED date precision (a month window never
 * renders as an exact day) and its evidence-aware status — the feed carries
 * no completed-release field, so entries stay Scheduled / Past-scheduled and
 * are never presented as TWRA release records.
 */
import type { StockingEvent } from '@trout/contracts';
import { stockingPrecisionDate, stockingStatusLabel, type StockingPrecision } from '../lib/format';

export interface Props {
  events: StockingEvent[];
  /** ISO date (YYYY-MM-DD) splitting scheduled from past-scheduled rows;
   *  defaults to the build date. Injectable so tests can pin it. */
  todayIso?: string;
}

const { events, todayIso = new Date().toISOString().slice(0, 10) } = Astro.props;
const speciesLabel: Record<string, string> = {
  rainbow: 'Rainbow',
  brown: 'Brown',
  cutbow: 'Cutbow',
  brook: 'Brook',
  other: 'Other',
};
---

{
  events.length > 0 ? (
    <table class="data-table">
      <caption>Published stocking schedule entries (verify officially)</caption>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Water</th>
          <th scope="col">County</th>
          <th scope="col">Species</th>
          <th class="num" scope="col">Count</th>
          <th scope="col">Status</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {events
          .slice()
          .sort((a, b) => b.date.localeCompare(a.date))
          .map((e) => (
            <tr>
              <td>{stockingPrecisionDate(e.date, e.datePrecision as StockingPrecision | undefined)}</td>
              <td>{e.streamName}</td>
              <td>{e.county ?? '—'}</td>
              <td>{speciesLabel[e.species] ?? e.species}</td>
              <td class="num">{e.count?.toLocaleString('en-US') ?? '—'}</td>
              <td>{stockingStatusLabel(e.date, e.datePrecision as StockingPrecision | undefined, todayIso)}</td>
              <td>
                <a href={e.sourceUrl} rel="nofollow">
                  official ↗
                </a>
              </td>
            </tr>
          ))}
      </tbody>
    </table>
  ) : (
    <p>No stocking entries recorded yet.</p>
  )
}

{
  "//": "OWNER: ROLE 2 — PWA (React 18 + Vite 5 + vite-plugin-pwa + Tailwind + Dexie). ROLE 1 created only this empty-but-green shell.",
  "name": "@trout/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && node scripts/copy-pack-fallback.mjs && vite build && node scripts/size-budget.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build:seo": "pnpm run build && pnpm run prerender",
    "build:fixtures": "tsc --noEmit -p tsconfig.json && vite build --config vite.fixtures.config.ts && node scripts/size-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "icons:generate": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@trout/contracts": "workspace:*",
    "@trout/ui": "workspace:*",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "maplibre-gl": "^6.7.0",
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@trout/content": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "d3-contour": "^4.0.2",
    "fake-indexeddb": "^6.0.0",
    "geotiff": "^3.0.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.3",
    "workbox-window": "^7.1.6"
  }
}
